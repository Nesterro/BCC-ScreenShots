<Window x:Class="BCCScreenShot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenShot Studio — Аннотации и снимки экрана" 
        Icon="pack://application:,,,/app_icon.ico"
        Height="840" Width="1320"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip"
        Background="#0B0F19" Foreground="#F8FAFC"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Modern Windows 11 / Fluent Dark Color Palette -->
        <SolidColorBrush x:Key="BgDark" Color="#0B0F19"/>
        <SolidColorBrush x:Key="BgSidebar" Color="#111827"/>
        <SolidColorBrush x:Key="BgCard" Color="#1E293B"/>
        <SolidColorBrush x:Key="BgHover" Color="#334155"/>
        <SolidColorBrush x:Key="AccentRed" Color="#A62639"/>
        <SolidColorBrush x:Key="AccentIndigo" Color="#6366F1"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#06B6D4"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="TextMain" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>
        <SolidColorBrush x:Key="BorderLight" Color="#2E3A52"/>

        <!-- Soft Pill Tool Button Style -->
        <Style x:Key="ToolButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2D1525"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#A62639"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Soft Header Button Style -->
        <Style x:Key="HeaderBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="4,3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Color Swatch Button Style -->
        <Style x:Key="ColorSwatchStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="#FFFFFF" 
                                BorderThickness="1.5" 
                                CornerRadius="14"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Callout Color Swatch Style -->
        <Style x:Key="CalloutColorSwatchStyle" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="#64748B" 
                                BorderThickness="1.5" 
                                CornerRadius="6"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtnStyle" BasedOn="{StaticResource HeaderBtnStyle}" TargetType="Button">
            <Setter Property="Background" Value="#A62639"/>
            <Setter Property="BorderBrush" Value="#801C2B"/>
        </Style>
        <Style x:Key="SuccessBtnStyle" BasedOn="{StaticResource HeaderBtnStyle}" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="BorderBrush" Value="#059669"/>
        </Style>
        <Style x:Key="DangerBtnStyle" BasedOn="{StaticResource HeaderBtnStyle}" TargetType="Button">
            <Setter Property="Background" Value="#7F1D1D"/>
            <Setter Property="BorderBrush" Value="#EF4444"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BgDark}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- Top Navigation Bar -->
        <Border Grid.Row="0" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Modern App Brand Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Border Width="34" Height="34" CornerRadius="10" Background="#1E293B" BorderBrush="#6366F1" BorderThickness="1.5" Margin="0,0,10,0">
                        <Image Source="pack://application:,,,/app_icon.png" Width="22" Height="22"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ScreenShot Studio" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Аннотации и снимки экрана" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Action Buttons -->
                <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button x:Name="BtnCaptureArea" Content="✂️ Рамкой" Style="{StaticResource PrimaryBtnStyle}" Click="BtnCaptureArea_Click" ToolTip="✂️ Скриншот выделенной области экрана (быстрое выделение)"/>
                    <Button x:Name="BtnCaptureScreen" Content="📸 Экран ▾" Style="{StaticResource HeaderBtnStyle}" Click="BtnCaptureScreen_Click" ToolTip="📸 Снимок экрана. Нажмите для выбора дисплея (основной, внешний или все)"/>
                    <Button x:Name="BtnOpenFile" Content="📁 Файл" Style="{StaticResource HeaderBtnStyle}" Click="BtnOpenFile_Click" ToolTip="📁 Открыть файл с диска"/>
                    <Button x:Name="BtnDemo" Content="🖼️ Демо" Style="{StaticResource HeaderBtnStyle}" Click="BtnDemo_Click" ToolTip="🖼️ Загрузить демо-снимок"/>

                    <Rectangle Width="1" Height="22" Fill="{StaticResource BorderLight}" Margin="6,4"/>

                    <Button x:Name="BtnUndo" Content="↩️ Отмена" Style="{StaticResource HeaderBtnStyle}" Click="BtnUndo_Click" ToolTip="Отменить последнее действие (Ctrl+Z)"/>
                    <Button x:Name="BtnRedo" Content="↪️ Повтор" Style="{StaticResource HeaderBtnStyle}" Click="BtnRedo_Click" ToolTip="Повторить отмененное действие (Ctrl+Y)"/>
                    <Button x:Name="BtnDeleteSelected" Content="❌ Удалить" Style="{StaticResource DangerBtnStyle}" Click="BtnDeleteSelected_Click" ToolTip="Удалить выделенный элемент (Delete)"/>
                    <Button x:Name="BtnClear" Content="🗑️ Очистить" Style="{StaticResource HeaderBtnStyle}" Click="BtnClear_Click" ToolTip="Очистить все рисунки"/>

                    <Rectangle Width="1" Height="22" Fill="{StaticResource BorderLight}" Margin="6,4"/>

                    <Button x:Name="BtnCopy" Content="📋 В буфер (Ctrl+C)" Style="{StaticResource HeaderBtnStyle}" Click="BtnCopy_Click" ToolTip="Скопировать изображение в буфер обмена Windows"/>
                    <Button x:Name="BtnSave" Content="💾 Сохранить PNG" Style="{StaticResource SuccessBtnStyle}" Click="BtnSave_Click" ToolTip="Сохранить файл на диск в исходном качестве (Ctrl+S)"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Workspace Grid -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <!-- Left Tools Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,1,0" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="ВЫБОР И ДВИЖЕНИЕ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="4,4,4,4"/>
                        <RadioButton x:Name="ToolSelect" Content="↖ Выбор (Esc)" Style="{StaticResource ToolButtonStyle}" IsChecked="True" Checked="Tool_Checked" Tag="select"/>

                        <TextBlock Text="УКАЗАТЕЛИ И МЕТКИ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="4,14,4,4"/>
                        <RadioButton x:Name="ToolArrow" Content="↗ Стрелка (A)" Style="{StaticResource ToolButtonStyle}" Checked="Tool_Checked" Tag="arrow"/>
                        <RadioButton x:Name="ToolCallout" Content="💬 Выноска (C)" Style="{StaticResource ToolButtonStyle}" Checked="Tool_Checked" Tag="callout"/>
                        <RadioButton x:Name="ToolStep" Content="1️⃣ Метка (N)" Style="{StaticResource ToolButtonStyle}" Checked="Tool_Checked" Tag="step"/>

                        <TextBlock Text="ФИГУРЫ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="4,14,4,4"/>
                        <RadioButton x:Name="ToolRect" Content="🔲 Рамка (R)" Style="{StaticResource ToolButtonStyle}" Checked="Tool_Checked" Tag="rect"/>
                        <RadioButton x:Name="ToolEllipse" Content="⭕ Овал (E)" Style="{StaticResource ToolButtonStyle}" Checked="Tool_Checked" Tag="ellipse"/>
                        <RadioButton x:Name="ToolLine" Content="📏 Линия (L)" Style="{StaticResource ToolButtonStyle}" Checked="Tool_Checked" Tag="line"/>

                        <TextBlock Text="РИСОВАНИЕ И ТЕКСТ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="4,14,4,4"/>
                        <RadioButton x:Name="ToolText" Content="🔤 Текст (T)" Style="{StaticResource ToolButtonStyle}" Checked="Tool_Checked" Tag="text"/>
                        <RadioButton x:Name="ToolPencil" Content="✏️ Карандаш (P)" Style="{StaticResource ToolButtonStyle}" Checked="Tool_Checked" Tag="pencil"/>
                        <RadioButton x:Name="ToolHighlighter" Content="🖍️ Маркер (H)" Style="{StaticResource ToolButtonStyle}" Checked="Tool_Checked" Tag="highlighter"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Canvas Viewport Area with Zoom & Pan Support -->
            <ScrollViewer x:Name="CanvasScrollViewer" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#0B0F19" PreviewMouseWheel="CanvasScrollViewer_PreviewMouseWheel">
                <Grid x:Name="CanvasViewportGrid" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="25">
                    <Border x:Name="CanvasContainer" CornerRadius="8" Background="#0F172A" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Border.LayoutTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="CanvasScaleTransform" ScaleX="1" ScaleY="1"/>
                            </TransformGroup>
                        </Border.LayoutTransform>
                        <Canvas x:Name="DrawingCanvas" Width="900" Height="560" ClipToBounds="True"
                                SnapsToDevicePixels="True" UseLayoutRounding="True"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                MouseLeftButtonDown="Canvas_MouseDown"
                                MouseMove="Canvas_MouseMove"
                                MouseLeftButtonUp="Canvas_MouseUp">

                            <!-- Visual Selection Box Overlay -->
                            <Rectangle x:Name="SelectionBoxBorder" Stroke="#06B6D4" StrokeThickness="1.5" StrokeDashArray="4 2" Visibility="Collapsed" IsHitTestVisible="False"/>

                            <!-- Box Corner Handles (Rect, Ellipse, Text, Badge) -->
                            <Rectangle x:Name="HandleTL" Width="10" Height="10" Fill="#FFFFFF" Stroke="#06B6D4" StrokeThickness="2" RadiusX="2" RadiusY="2" Visibility="Collapsed" Cursor="SizeNWSE" MouseLeftButtonDown="Handle_MouseDown" MouseLeftButtonUp="Handle_MouseUp"/>
                            <Rectangle x:Name="HandleTR" Width="10" Height="10" Fill="#FFFFFF" Stroke="#06B6D4" StrokeThickness="2" RadiusX="2" RadiusY="2" Visibility="Collapsed" Cursor="SizeNESW" MouseLeftButtonDown="Handle_MouseDown" MouseLeftButtonUp="Handle_MouseUp"/>
                            <Rectangle x:Name="HandleBL" Width="10" Height="10" Fill="#FFFFFF" Stroke="#06B6D4" StrokeThickness="2" RadiusX="2" RadiusY="2" Visibility="Collapsed" Cursor="SizeNESW" MouseLeftButtonDown="Handle_MouseDown" MouseLeftButtonUp="Handle_MouseUp"/>
                            <Rectangle x:Name="HandleBR" Width="10" Height="10" Fill="#FFFFFF" Stroke="#06B6D4" StrokeThickness="2" RadiusX="2" RadiusY="2" Visibility="Collapsed" Cursor="SizeNWSE" MouseLeftButtonDown="Handle_MouseDown" MouseLeftButtonUp="Handle_MouseUp"/>

                            <!-- Line / Arrow Endpoint Handles -->
                            <Ellipse x:Name="HandleP1" Width="12" Height="12" Fill="#FFFFFF" Stroke="#06B6D4" StrokeThickness="2.5" Visibility="Collapsed" Cursor="Hand" MouseLeftButtonDown="Handle_MouseDown" MouseLeftButtonUp="Handle_MouseUp"/>
                            <Ellipse x:Name="HandleP2" Width="12" Height="12" Fill="#06B6D4" Stroke="#FFFFFF" StrokeThickness="2" Visibility="Collapsed" Cursor="Hand" MouseLeftButtonDown="Handle_MouseDown" MouseLeftButtonUp="Handle_MouseUp"/>
                        </Canvas>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- Right Inspector Sidebar -->
            <Border Grid.Column="2" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1,0,0,0" Padding="15">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Main Stroke Color -->
                        <TextBlock Text="ЦВЕТ КОНТУРА" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>
                        <UniformGrid Columns="5" Margin="0,0,0,10">
                            <Button Style="{StaticResource ColorSwatchStyle}" Background="#A62639" Click="ColorSwatch_Click" Tag="#A62639" ToolTip="Бордовый"/>
                            <Button Style="{StaticResource ColorSwatchStyle}" Background="#F97316" Click="ColorSwatch_Click" Tag="#F97316" ToolTip="Оранжевый"/>
                            <Button Style="{StaticResource ColorSwatchStyle}" Background="#EAB308" Click="ColorSwatch_Click" Tag="#EAB308" ToolTip="Жёлтый"/>
                            <Button Style="{StaticResource ColorSwatchStyle}" Background="#22C55E" Click="ColorSwatch_Click" Tag="#22C55E" ToolTip="Зелёный"/>
                            <Button Style="{StaticResource ColorSwatchStyle}" Background="#06B6D4" Click="ColorSwatch_Click" Tag="#06B6D4" ToolTip="Циан"/>
                            <Button Style="{StaticResource ColorSwatchStyle}" Background="#3B82F6" Click="ColorSwatch_Click" Tag="#3B82F6" ToolTip="Синий"/>
                            <Button Style="{StaticResource ColorSwatchStyle}" Background="#A855F7" Click="ColorSwatch_Click" Tag="#A855F7" ToolTip="Фиолетовый"/>
                            <Button Style="{StaticResource ColorSwatchStyle}" Background="#EC4899" Click="ColorSwatch_Click" Tag="#EC4899" ToolTip="Розовый"/>
                            <Button Style="{StaticResource ColorSwatchStyle}" Background="#FFFFFF" Click="ColorSwatch_Click" Tag="#FFFFFF" ToolTip="Белый"/>
                            <Button Style="{StaticResource ColorSwatchStyle}" Background="#000000" Click="ColorSwatch_Click" Tag="#000000" ToolTip="Чёрный"/>
                        </UniformGrid>

                        <Separator Background="{StaticResource BorderLight}" Margin="0,12"/>

                        <!-- Callout Style & Background Settings -->
                        <Border Background="{StaticResource BgCard}" CornerRadius="10" Padding="10" Margin="0,0,0,6" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="💬 ФОН ВЫНОСКИ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,6"/>
                                <TextBlock Text="Быстрый выбор фона:" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                                <WrapPanel Margin="0,0,0,8">
                                    <Button Content="⬛ Тёмный" Style="{StaticResource HeaderBtnStyle}" Padding="6,4" Margin="2" Click="CalloutBgPreset_Click" Tag="#1E293B" ToolTip="Тёмный графит (#1E293B)"/>
                                    <Button Content="⬜ Светлый" Style="{StaticResource HeaderBtnStyle}" Padding="6,4" Margin="2" Click="CalloutBgPreset_Click" Tag="#FFFFFF" ToolTip="Чистый белый (#FFFFFF)"/>
                                    <Button Content="🟨 Стикер" Style="{StaticResource HeaderBtnStyle}" Padding="6,4" Margin="2" Click="CalloutBgPreset_Click" Tag="#FEF08A" ToolTip="Жёлтый стикер (#FEF08A)"/>
                                    <Button Content="🎨 В цвет" Style="{StaticResource HeaderBtnStyle}" Padding="6,4" Margin="2" Click="CalloutBgPreset_Click" Tag="accent" ToolTip="В цвет контура выноски"/>
                                    <Button Content="🚫 Без фона" Style="{StaticResource HeaderBtnStyle}" Padding="6,4" Margin="2" Click="CalloutBgPreset_Click" Tag="transparent" ToolTip="Прозрачный фон"/>
                                </WrapPanel>

                                <TextBlock Text="Палитра фона выноски:" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,4,0,4"/>
                                <UniformGrid Columns="5" Margin="0,0,0,4">
                                    <Button Style="{StaticResource CalloutColorSwatchStyle}" Background="#1E293B" Click="CalloutBgColor_Click" Tag="#1E293B" ToolTip="Тёмный графит"/>
                                    <Button Style="{StaticResource CalloutColorSwatchStyle}" Background="#FFFFFF" Click="CalloutBgColor_Click" Tag="#FFFFFF" ToolTip="Белый"/>
                                    <Button Style="{StaticResource CalloutColorSwatchStyle}" Background="#FEF08A" Click="CalloutBgColor_Click" Tag="#FEF08A" ToolTip="Жёлтый пастельный"/>
                                    <Button Style="{StaticResource CalloutColorSwatchStyle}" Background="#E0F2FE" Click="CalloutBgColor_Click" Tag="#E0F2FE" ToolTip="Светло-голубой"/>
                                    <Button Style="{StaticResource CalloutColorSwatchStyle}" Background="#DCFCE7" Click="CalloutBgColor_Click" Tag="#DCFCE7" ToolTip="Светло-зелёный"/>
                                    <Button Style="{StaticResource CalloutColorSwatchStyle}" Background="#FEE2E2" Click="CalloutBgColor_Click" Tag="#FEE2E2" ToolTip="Светло-красный"/>
                                    <Button Style="{StaticResource CalloutColorSwatchStyle}" Background="#F3E8FF" Click="CalloutBgColor_Click" Tag="#F3E8FF" ToolTip="Светло-фиолетовый"/>
                                    <Button Style="{StaticResource CalloutColorSwatchStyle}" Background="#A62639" Click="CalloutBgColor_Click" Tag="#A62639" ToolTip="Бордовый"/>
                                    <Button Style="{StaticResource CalloutColorSwatchStyle}" Background="#06B6D4" Click="CalloutBgColor_Click" Tag="#06B6D4" ToolTip="Циан"/>
                                    <Button Style="{StaticResource CalloutColorSwatchStyle}" Background="#00000000" Click="CalloutBgColor_Click" Tag="#00000000" ToolTip="Прозрачный"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Separator Background="{StaticResource BorderLight}" Margin="0,10"/>

                        <!-- Step Counter Settings -->
                        <TextBlock Text="Нумерация меток (1️⃣)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Следующая метка:" FontSize="12" Foreground="{StaticResource TextMain}" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtNextStepVal" Grid.Column="1" Text="1" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" Background="#1E293B" BorderBrush="{StaticResource BorderLight}" Padding="4,2" HorizontalContentAlignment="Center" TextChanged="TxtNextStepVal_TextChanged"/>
                        </Grid>

                        <Separator Background="{StaticResource BorderLight}" Margin="0,10"/>

                        <!-- Shape Fill / Shading Options -->
                        <TextBlock Text="Заливка фигур" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkEnableFill" Content="Заливка фона фигуры" Foreground="{StaticResource TextMain}" FontSize="12" Margin="0,0,0,8" Checked="ChkEnableFill_Changed" Unchecked="ChkEnableFill_Changed"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="45"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SliderFillOpacity" Minimum="5" Maximum="100" Value="30" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderFillOpacity_ValueChanged"/>
                            <TextBlock x:Name="TxtFillOpacityVal" Grid.Column="1" Text="30%" FontSize="12" Foreground="{StaticResource AccentCyan}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Separator Background="{StaticResource BorderLight}" Margin="0,10"/>

                        <TextBlock Text="Толщина линии" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,5"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="45"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SliderStroke" Minimum="1" Maximum="24" Value="4" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SliderStroke_ValueChanged"/>
                            <TextBlock x:Name="TxtStrokeVal" Grid.Column="1" Text="4 px" FontSize="12" Foreground="{StaticResource AccentCyan}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="Размер шрифта" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,5"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="45"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SliderFont" Minimum="12" Maximum="64" Value="18" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SliderFont_ValueChanged"/>
                            <TextBlock x:Name="TxtFontVal" Grid.Column="1" Text="18 px" FontSize="12" Foreground="{StaticResource AccentCyan}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Separator Background="{StaticResource BorderLight}" Margin="0,10"/>

                        <TextBlock Text="Подсказки по управлению" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                        <TextBlock Text="• Ctrl + Перетаскивание мышью — скопировать элемент" FontSize="11" Foreground="{StaticResource AccentCyan}" TextWrapping="Wrap" Margin="0,2"/>
                        <TextBlock Text="• Ctrl + Колесико — Масштабирование (Ctrl + 0 — 100%)" FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,2"/>
                        <TextBlock Text="• Двойной клик по выноске — изменить текст" FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,2"/>
                        <TextBlock Text="• Двойной клик по метке 1️⃣ — изменить номер" FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,2"/>
                        <TextBlock Text="• Esc — сбросить инструмент на Выбор" FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,2"/>

                        <Separator Background="{StaticResource BorderLight}" Margin="0,10"/>

                        <TextBlock Text="Горячие клавиши" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                        <TextBlock Text="Ctrl + C — Скопировать в буфер" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2"/>
                        <TextBlock Text="Ctrl + S — Сохранить PNG" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2"/>
                        <TextBlock Text="Ctrl + Z — Отменить" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2"/>
                        <TextBlock Text="Ctrl + Y — Повторить (вернуть)" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2"/>
                        <TextBlock Text="Delete / Backspace — Удалить элемент" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid>
                <TextBlock x:Name="TxtStatus" Text="Готово. Сделайте снимок или откройте файл." FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtCanvasSize" Text="900 × 560 px" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,15,0" VerticalAlignment="Center"/>
                    <Button x:Name="BtnFitZoom" Content="📐 По размеру" Style="{StaticResource HeaderBtnStyle}" Padding="8,2" Margin="0,0,6,0" Click="BtnFitZoom_Click" ToolTip="Вписать изображение в размер окна"/>
                    <Button x:Name="BtnResetZoom" Content="🔍 100%" Style="{StaticResource HeaderBtnStyle}" Padding="8,2" Margin="0" Click="BtnResetZoom_Click" ToolTip="Сбросить масштаб холста на 100% (Ctrl + 0)"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
